# 复制为 .env 后按实际环境修改；所有变量统一 PW_ 前缀
PW_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/police_workbench
PW_JWT_SECRET=please-change-this-secret-in-production
PW_JWT_ALGORITHM=HS256
PW_ACCESS_TOKEN_EXPIRE_MINUTES=120
PW_AUTH_WHITELIST=/api/auth/login,/health,/docs,/redoc,/openapi.json,/favicon.ico
PW_SQL_ECHO=false
